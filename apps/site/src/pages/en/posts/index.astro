---
import PostsPage from "../../../components/PostsPage.astro";
import { getEntries, getEntryBySlug, getSectionPage } from "../../../lib/content.js";
import type { SiteEntry } from "../../../lib/content.js";

const lang = "en";
const section = await getSectionPage("posts", lang);
const posts = await getEntries("posts", { lang });
const programProjects = (await Promise.all([
  "ai-game-project-management",
  "ai-game-creation-research",
  "action-game-ip-design"
].map((slug) => getEntryBySlug("projects", slug, lang)))).filter((entry): entry is SiteEntry => Boolean(entry));
---

<PostsPage lang={lang} section={section} posts={posts} programProjects={programProjects} alternatePath="/posts/" />
