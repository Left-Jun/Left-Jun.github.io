---
import ProjectLayout from "../../components/ProjectLayout.astro";
import ProgramProjectLayout from "../../components/ProgramProjectLayout.astro";
import { getEntries } from "../../lib/content.js";

export async function getStaticPaths() {
  return (await getEntries("projects", { lang: "zh-cn" })).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
---
{entry.data.program === "guanghe-campus-co-creation"
  ? <ProgramProjectLayout entry={entry} />
  : <ProjectLayout entry={entry} />}
